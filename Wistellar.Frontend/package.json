{
	"name": "wistellar.frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@maplibre/geojson-vt": "^6.3.1",
		"@maplibre/vt-pbf": "^4.3.3",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@turf/circle": "^7.4.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"axios": "^1.21.1",
		"jose": "^6.2.17",
		"jsooner": "^1.5.0",
		"jwt-decode": "^4.0.0",
		"maplibre-gl": "^6.17.0",
		"tailwindcss": "^4.3.5"
	}
}
