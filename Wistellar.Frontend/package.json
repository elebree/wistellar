{
	"name": "wistellar.frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@maplibre/geojson-vt": "^6.1.2",
		"@maplibre/vt-pbf": "^4.3.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@turf/circle": "^7.4.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"axios": "^1.20.0",
		"jose": "^6.2.13",
		"jsooner": "^1.1.0",
		"jwt-decode": "^4.0.0",
		"maplibre-gl": "^5.24.0",
		"tailwindcss": "^4.3.3"
	}
}
